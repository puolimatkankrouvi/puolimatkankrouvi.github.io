<style>
    a {
        font-size: 1.25rem;
    }

    p {
        font-size: 1.25rem;
    }

    p + ul {
        margin-top: 2rem;
    }

    ul {
        list-style-type: none;
    }

    li {
        padding: 0.2rem;
    }
</style>