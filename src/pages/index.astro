---
import BaseLayout from "../layouts/baseLayout.astro"
import List from "../components/List.astro";
import "../css/global.css";

layout: "/layouts/baseLayout.astro";
import { fontSize } from "../css/constants";
import Li from "../components/Li.astro";
---

<BaseLayout title="Puolimatkankrouvi" headerTitle="Etusivu | puolimatkankrouvi">
    <p>Nettisivu omaan henkilökohtaiseen käyttööni. Sisältää muistiinpanoja mediasisällöistä.</p>
    <List>
        <Li>
            <a href="/musiikkisuosituksia">Musiikkisuosituksia</a>
        </Li> 
    </List>
</BaseLayout>

<style define:vars={{ fontSize }}>
    a {
        font-size: var(--fontSize);
    }

    p {
        font-size: var(--fontSize);
        margin-bottom: 2rem;
    }
</style>